# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com os dados da sua máquina.
#
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# O `.env` NÃO vai para o Git (está no .gitignore). Nunca versione a senha real.
# ---------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=troque-por-uma-chave-secreta-longa
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (MySQL/MariaDB)
#
# O `banco.sql` cria o schema `hub_fcc_of` (passo 5 do README). Se você
# importou com esse nome, use DB_NAME=hub_fcc_of aqui. Se você criou o banco
# com outro nome, ponha o mesmo nome aqui — o Django só precisa apontar para a
# base que tem as tabelas do banco.sql.
DB_NAME=hub_fcc_of
DB_USER=root
DB_PASSWORD=sua_senha_local
DB_HOST=localhost
DB_PORT=3306

# Fuso usado na sessão MySQL. Padrão: UTC, que é o que o Django espera com
# USE_TZ=True. Se o seu MySQL tiver a tabela de fusos carregada, prefira
# 'America/Sao_Paulo' — acompanha o horário de verão.
# Veja a seção "Fuso horário" no final de hub_fecc/settings.py.
TIME_ZONE_BANCO=+00:00

# E-mails da equipe gestora (acesso ao /admin/ e às views admin_required),
# separados por vírgula. Precisa estar aqui ANTES de criar a conta, e o
# cadastro público recusa esses e-mails.
ADMIN_EMAILS=admin@exemplo.com

# Envio de e-mail (recuperação de senha, RF-023).
# Sem EMAIL_HOST, o Django usa o backend de console: o link aparece no
# terminal em que o servidor está rodando. Preencha para envio real.
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=naoresponda@hubfecc.com.br
